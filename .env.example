# The bot starts in PAPER mode and never sends live orders by default.
TRADING_MODE=PAPER
DEMO_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
DATABASE_URL=sqlite:///./trading.db
ALLOWED_SYMBOLS=EURUSD,GBPUSD,USDJPY
# Lot ölçüsü balansın bu faizini risk edərək dinamik hesablanır (bax: app/sizing.py)
RISK_PER_TRADE_PCT=1.0
# Mütləq təhlükəsizlik tavanı — hesablanan lot bundan böyük ola bilməz
MAX_VOLUME=2.0
MAX_OPEN_POSITIONS_PER_SYMBOL=1
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
# AI chat köməkçisi üçün (pulsuz: https://console.groq.com/keys)
GROQ_API_KEY=

# --- Instagram (Meta) avtomatik paylaşım ---
# Meta App Dashboard -> Use cases -> Instagram API -> API setup with Instagram login
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0
